# Copy to .env.local. NEVER commit .env.local. Verify .gitignore BEFORE first commit (H6).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
UPLIFTAI_API_KEY=        # NOT UPLIFT_API_KEY -- this exact name, config.py:19 + the plugin both read it (H3)
GLADIA_API_KEY=
GOOGLE_API_KEY=

# ── en multi-provider set (docs/UKASHA_AGENT_FACING_MULTIPLE_PROVIDERS_PLAN.md, ADR-036) ──
# Only needed for agent_language="en" agents selecting these providers; ur is unaffected.
DEEPGRAM_API_KEY=        # en STT, enabled (Phase 6a)
GROQ_API_KEY=             # en LLM, enabled (Phase 6b) -- NEVER selectable for ur (guide's rule)
CARTESIA_API_KEY=        # en TTS, enabled (Phase 6c) -- must be a STANDARD key (play.cartesia.ai/keys),
                          # NOT an admin key (play.cartesia.ai/keys/admin) -- admin keys 401 on generation routes
ELEVEN_API_KEY=           # en TTS, enabled (Phase 6d) -- NOT ELEVENLABS_API_KEY, this exact name
FISH_API_KEY=             # en TTS, coded+tested but BLOCKED (state/BLOCKERS.md::BLOCK-FISHAUDIO --
                          # account needs funding, returns 402 Payment Required on synthesize calls)
RIME_API_KEY=             # en TTS, enabled (Phase 6f)

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE=   # migrations + scripts/upload_voice_previews.py + worker
                            # session recording upload (worker/session_recording.py). Also used by
                            # human-approved Storage scripts. NOT db.py (removed, ADR-022) and NOT the
                            # control-plane mint (uses SUPABASE_DB_URL, a different credential).
                            # Required on the LiveKit worker for call recordings to appear in Activity.

# ── control plane (docs/62-GUIDE-PROD-ENV-VARS.md) ──
CP_ALLOWED_ORIGINS=     # comma-separated CORS allowlist for control plane (e.g. https://dashboard.example.com).
                         # Empty or unset defaults to permissive (allow all) for dev.

# ── switches (docs/30-GUIDE-FREE-TIER.md §6) ──
UPLIFT_MODE=fixture      # fixture | record | live   <- fixture is the ONLY safe default
# UPLIFT_PHRASE_CONFIG_ID=           # Uplift account phrase-replacement config id (brand/pronunciation)
# UPLIFT_USE_PHRASE_CONFIG_FILE=0    # 1 = fall back to repo .uplift_phrase_config (account-tied; prefer env id)
# UPLIFT_DISABLE_PHRASE_CONFIG=0     # 1 = never pass phrase_replacement_config_id
STT_PROVIDER=gladia      # gladia | soniox           <- soniox = one env var, never a refactor
LLM_MODE=fixture         # fixture | live  -- VESTIGIAL: not read by worker/ or config.py at all,
                          # only referenced in tests/conftest.py's old CER-harness offline guard.
                          # Does not affect the real live worker's LLM calls either way.

# ── client tool gateway (OPTIONAL local-dev fallback only) ──
# Preferred: each agent stores tools_base_url + tools_auth_secret in the DB
# (self-serve sets these from PUBLIC_BASE_URL + TOOL_GATEWAY_SECRET on assemble).
# These worker env vars are a single-client fallback for local testing only —
# do NOT rely on them for multi-client production.
# UVA_TOOLS_BASE_URL=http://localhost:3001
# TOOL_GATEWAY_SECRET=same-as-self-serve-TOOL_GATEWAY_SECRET
# GROQ_PROMPT_SOFT_CHARS=3000   # shrink tenant persona above this size for Groq
# UVA_FORCE_GROQ_ENGLISH=1      # English WebRTC: remap Gemini→Groq when GROQ_API_KEY set (0=keep Gemini)
# GROQ_LLM_MODEL=openai/gpt-oss-20b   # free/dev production default (llama + qwen3.6 retired/404)
# GEMINI_LLM_MODEL=gemini-3.6-flash   # worker remaps gemini-2.5-flash → this; A/B: gemini-3.8-flash
# GEMINI_THINKING_LEVEL=minimal       # Gemini 3 only: minimal|low|medium|high (does not change temperature)
# CARTESIA_TTS_MODEL=                 # Phase 5A demo-only when agent tts_options omit model (e.g. sonic-3.6)
# UVA_SESSION_RECORD_AUDIO=0          # local demo: skip RecorderIO to speed session.start (default off in code)
# UVA_INTERRUPTION_MODE=vad           # vad (default, faster session.start) | adaptive (LiveKit Cloud ML barge-in)
# UVA_DEEPGRAM_ENDPOINTING_MS=200     # Deepgram Nova EOU (default 200=human-turn). A/B: 10|100|300|500
# UVA_DEEPGRAM_STT_MODE=nova          # nova (default) | flux (STTv2 flux-general-en, EndOfTurn only)
# UVA_DEEPGRAM_FLUX_EAGER_EOT=0       # 1 = Gemini Flux Eager EOT A/B (ignored for Groq)
# UVA_DEEPGRAM_FLUX_EAGER_EOT_THRESHOLD=0.5  # only when eager enabled (0.3–0.9)
# UVA_TURN_DETECTOR=off               # off (default) | v1-mini (local) | v1 (hosted). English only; measure start_ms
# UVA_CHAT_HISTORY_MAX_ITEMS=48       # default 48; set 0 to disable ChatContext.truncate
# LIVEKIT_NUM_IDLE_PROCESSES=3        # warm job processes kept ready (default 3; cuts cold job spawn)
# UVA_GREETING_INTERRUPTIBLE=1        # agent-first greeting barge-in (0 if mic-echo on connect)
# UVA_DUMP_PROMPTS=1               # write docs/last_session_prompt.txt each call (default on)
#
# Optional cold-start seeds (first call after boot — no-op when unset):
# UVA_PREWARM_GREETING_TEXT=Hello, thanks for calling.
# UVA_PREWARM_AGENT_ID=               # must match the demo agent UUID
# UVA_PREWARM_TTS_VOICE_ID=           # Cartesia provider voice id for that agent
# UVA_PREWARM_TTS_PROVIDER=cartesia
# UVA_PREWARM_AUDIO_CHANNEL=webrtc
# UVA_PREWARM_PROVIDER_STACK=1        # construct default STT/LLM/TTS into job-thread cache
# UVA_PREWARM_STT_PROVIDER=deepgram
# UVA_PREWARM_LLM_PROVIDER=groq
# UVA_PREWARM_LLM_MODEL=openai/gpt-oss-20b

# ── admin portal (docs/26-PHASE-6-ADMIN.md) — completely separate from tenant/LiveKit auth ──
ADMIN_JWT_SECRET=        # auto-generated + persisted here by admin/app.py on first run if unset
ADMIN_PORTAL_ORIGINS=    # comma-separated CORS allowlist for the admin frontend ONLY.
                          # NEVER add a tenant/host-platform origin here (GATE 6 line 4).
                          # Defaults to http://localhost:5173 if unset.

# telephony backend (docs/TELEPHONY_REAL_PROVIDER_STAGING.md)
TELEPHONY_PROVIDER_MODE=real         # real for staging/prod. mock/test/local only for explicit offline tests.
TELEPHONY_CREDENTIAL_ENCRYPTION_KEY= # Required in real mode. Encrypts stored tenant Telnyx API key refs.
TELNYX_PUBLIC_KEY=                    # Required in real mode. Telnyx API v2 Ed25519 webhook public key.
TELEPHONY_WEBHOOK_PUBLIC_BASE_URL=   # Public URL base for receiving Telnyx webhooks.
TELEPHONY_ENABLE_REAL_PROVIDER_TESTS=false # Gated flag for live provider tests (default false).
# TELEPHONY_ALLOW_MOCK_MACHINE_AUTH= # Local tests only. Never set this in Render staging/prod.
