# Copy to .env.local. NEVER commit .env.local. Verify .gitignore BEFORE first commit (H6).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
UPLIFTAI_API_KEY=        # NOT UPLIFT_API_KEY -- this exact name, config.py:19 + the plugin both read it (H3)
GLADIA_API_KEY=
GOOGLE_API_KEY=

# ── en multi-provider set (docs/UKASHA_AGENT_FACING_MULTIPLE_PROVIDERS_PLAN.md, ADR-036) ──
# Only needed for agent_language="en" agents selecting these providers; ur is unaffected.
DEEPGRAM_API_KEY=        # en STT, enabled (Phase 6a)
GROQ_API_KEY=             # en LLM, enabled (Phase 6b) -- NEVER selectable for ur (guide's rule)
CARTESIA_API_KEY=        # en TTS, enabled (Phase 6c) -- must be a STANDARD key (play.cartesia.ai/keys),
                          # NOT an admin key (play.cartesia.ai/keys/admin) -- admin keys 401 on generation routes
ELEVEN_API_KEY=           # en TTS, enabled (Phase 6d) -- NOT ELEVENLABS_API_KEY, this exact name
FISH_API_KEY=             # en TTS, coded+tested but BLOCKED (state/BLOCKERS.md::BLOCK-FISHAUDIO --
                          # account needs funding, returns 402 Payment Required on synthesize calls)
RIME_API_KEY=             # en TTS, enabled (Phase 6f)

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE=   # migrations + scripts/upload_voice_previews.py (human-approved,
                            # dev-only Storage script). NOT db.py (removed, ADR-022) and NOT the
                            # control-plane mint (uses SUPABASE_DB_URL, a different credential).

# ── control plane (docs/62-GUIDE-PROD-ENV-VARS.md) ──
CP_ALLOWED_ORIGINS=     # comma-separated CORS allowlist for control plane (e.g. https://dashboard.example.com).
                         # Empty or unset defaults to permissive (allow all) for dev.

# ── switches (docs/30-GUIDE-FREE-TIER.md §6) ──
UPLIFT_MODE=fixture      # fixture | record | live   <- fixture is the ONLY safe default
STT_PROVIDER=gladia      # gladia | soniox           <- soniox = one env var, never a refactor
LLM_MODE=fixture         # fixture | live  -- VESTIGIAL: not read by worker/ or config.py at all,
                          # only referenced in tests/conftest.py's old CER-harness offline guard.
                          # Does not affect the real live worker's LLM calls either way.

# ── admin portal (docs/26-PHASE-6-ADMIN.md) — completely separate from tenant/LiveKit auth ──
ADMIN_JWT_SECRET=        # auto-generated + persisted here by admin/app.py on first run if unset
ADMIN_PORTAL_ORIGINS=    # comma-separated CORS allowlist for the admin frontend ONLY.
                          # NEVER add a tenant/host-platform origin here (GATE 6 line 4).
                          # Defaults to http://localhost:5173 if unset.

# telephony backend (docs/TELEPHONY_REAL_PROVIDER_STAGING.md)
TELEPHONY_PROVIDER_MODE=real         # real for staging/prod. mock/test/local only for explicit offline tests.
TELEPHONY_CREDENTIAL_ENCRYPTION_KEY= # Required in real mode. Encrypts stored tenant Telnyx API key refs.
TELNYX_PUBLIC_KEY=                    # Required in real mode. Telnyx API v2 Ed25519 webhook public key.
TELEPHONY_WEBHOOK_PUBLIC_BASE_URL=   # Public URL base for receiving Telnyx webhooks.
TELEPHONY_ENABLE_REAL_PROVIDER_TESTS=false # Gated flag for live provider tests (default false).
# TELEPHONY_ALLOW_MOCK_MACHINE_AUTH= # Local tests only. Never set this in Render staging/prod.
