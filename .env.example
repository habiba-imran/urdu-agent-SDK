# Copy to .env.local. NEVER commit .env.local. Verify .gitignore BEFORE first commit (H6).
# This file is the canonical local/dev template (Wave 1 final).

# ── LiveKit ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=uva-dev-agent   # must match control-plane / worker registration
LIVEKIT_SIP_URI=                   # Telnyx inbound SIP target (telephony); leave empty for browser-only
LIVEKIT_NUM_IDLE_PROCESSES=3       # warm job processes (cuts cold job spawn)

# ── STT / LLM / TTS provider keys ──
UPLIFTAI_API_KEY=        # NOT UPLIFT_API_KEY — this exact name (config + plugin)
GLADIA_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=        # en STT
GROQ_API_KEY=            # en LLM — never selectable for ur
CARTESIA_API_KEY=        # en TTS — STANDARD key from play.cartesia.ai/keys (not admin)
ELEVEN_API_KEY=          # en TTS — NOT ELEVENLABS_API_KEY
FISH_API_KEY=            # en TTS — may 402 if account unfunded
RIME_API_KEY=            # en TTS

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=             # optional CLI / management scripts
SUPABASE_SERVICE_ROLE=             # worker session recording upload + Storage scripts
# Invite Accept → dashboard set-password page (also add this URL under Supabase Auth → Redirect URLs)
DASHBOARD_INVITE_REDIRECT_URL=http://localhost:3000/invite

# ── control plane ──
UVA_ENV=development           # development | staging | production. Hosted values make missing
                              # secrets / CORS allowlist fail at startup instead of falling back
                              # to dev defaults. Render also sets RENDER=true, which counts as hosted.
# ALLOW_DB_RESET=1            # P4-M3: required for `make db-reset` / scripts/db_reset.py.
                              # Never set on staging/prod — use `make db-migrate` only.
CP_ALLOWED_ORIGINS=           # comma-separated CORS allowlist. REQUIRED when hosted (F-C3);
                              # empty locally = localhost:3000/5173 only, never '*'
CP_ENABLE_DEV_MINT=           # 1 to expose POST /v1/session/dev-mint on a hosted deployment.
                              # Off by default: it mints a real session from an agent id (F-C2)
CP_DEV_MINT_RESET_QUOTA=      # 1 to let dev-mint zero the tenant's live concurrency count.
                              # Off by default - it defeats the concurrency cap (F-C2)
CP_ENABLE_DOCS=               # 1 to serve /docs and /redoc on a hosted deployment (F-M6)
CP_TENANT_SECRETS=                 # JSON map {"<tenant_id>":"<hmac_secret>",...} for local mint

# ── switches ──
UPLIFT_MODE=fixture                # fixture (tests/local) | record | live — production MUST use live
# UPLIFT_PHRASE_CONFIG_ID=         # Uplift phrase-replacement config id
# UPLIFT_USE_PHRASE_CONFIG_FILE=0  # 1 = fall back to repo .uplift_phrase_config
# UPLIFT_DISABLE_PHRASE_CONFIG=0   # 1 = never pass phrase_replacement_config_id
STT_PROVIDER=gladia                # legacy prewarm hint only; per-agent stt_provider wins
LLM_MODE=fixture                   # vestigial (tests only); does not gate the live worker

# ── client tool gateway (optional local-dev fallback) ──
# Prefer per-agent tools_base_url + tools_auth_secret in DB.
# UVA_TOOLS_BASE_URL=http://localhost:3001
# TOOL_GATEWAY_SECRET=

# ── Wave 1 voice / humanization / cold-start (safe defaults) ──
GROQ_PROMPT_SOFT_CHARS=3000
GROQ_LLM_MODEL=openai/gpt-oss-20b
# UVA_FORCE_GROQ_ENGLISH — deprecated/ignored; configured llm_provider always sticks
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal      # Gemini 3 only: minimal|low|medium|high
# F-H10 Phase D — LiveKit session connect retries (LLM/TTS/STT). Default 1; set 0 for fail-fast.
UVA_PROVIDER_MAX_RETRY=1
UVA_PROVIDER_RETRY_INTERVAL=1.0
UVA_PROVIDER_CONNECT_TIMEOUT=30
# CARTESIA_TTS_MODEL=              # demo override when agent tts_options omit model (e.g. sonic-3.6)
UVA_SESSION_RECORD_AUDIO=0         # local/dev only: force RecorderIO start when agents.recording_enabled is off (ignored on Render; prod needs agent opt-in). Persist still needs Phase C consent=granted.
UVA_RECORDING_RETENTION_DAYS=30    # days until purge may delete recording/transcript (F-C4 Phase D)
UVA_INTERRUPTION_MODE=vad          # vad (faster start) | adaptive
UVA_DEEPGRAM_ENDPOINTING_MS=100    # Nova EOU; A/B: 10|100|200|300|500 (100=snappy default)
UVA_DEEPGRAM_STT_MODE=nova         # nova | flux
UVA_DEEPGRAM_FLUX_EAGER_EOT=0      # 1 = Gemini Flux Eager EOT A/B (ignored for Groq)
UVA_DEEPGRAM_FLUX_EAGER_EOT_THRESHOLD=0.5
UVA_TURN_DETECTOR=off              # off | v1-mini | v1 (English only)
UVA_CHAT_HISTORY_MAX_ITEMS=48      # ChatContext window; 0=disable
UVA_GREETING_INTERRUPTIBLE=1       # 1=barge-in greeting (default); 0=locked opening line
# UVA_FORCE_BARGE_IN_FLUSH=0       # WebRTC default off (avoid false VAD chops); telephony default on
# F-M24: both default OFF in code when unset. Never enable dump on shared prod disks (PII/persona).
UVA_DUMP_PROMPTS=0                 # 1 = write docs/last_session_prompt.txt each call (local debug only)
UVA_LOG_TRANSCRIPTS=0              # 1 = log turn/speech text at INFO (capped; see UVA_LOG_TRANSCRIPT_CHARS)
# UVA_LOG_TRANSCRIPT_CHARS=200     # max chars when UVA_LOG_TRANSCRIPTS=1

# F-M25: worker health HTTP (off when unset/0). Habiba wires Render later.
# UVA_WORKER_HEALTH_PORT=8081      # e.g. 8081; curl http://127.0.0.1:8081/healthz
# UVA_WORKER_HEALTH_BIND=127.0.0.1 # use 0.0.0.0 for Docker/Render health probes

# F-L6: room publish of turn_latency / metrics_updated (default OFF). Server INFO logs stay on.
UVA_PUBLISH_TURN_LATENCY=0         # 1 = broadcast stage timings into the LiveKit room (debug only)

# Optional cold-start seeds (no-op when unset):
# UVA_PREWARM_GREETING_TEXT=Hello, thanks for calling.
# UVA_PREWARM_AGENT_ID=
# UVA_PREWARM_TTS_VOICE_ID=
# UVA_PREWARM_TTS_PROVIDER=cartesia
# UVA_PREWARM_AUDIO_CHANNEL=webrtc
# UVA_PREWARM_PROVIDER_STACK=1
# UVA_PREWARM_STT_PROVIDER=deepgram
# UVA_PREWARM_LLM_PROVIDER=groq
# UVA_PREWARM_LLM_MODEL=openai/gpt-oss-20b

# ── admin portal ──
ADMIN_JWT_SECRET=                  # REQUIRED when hosted - startup fails without it (F-H13).
                                   # Local dev auto-generates one into .env.local
ADMIN_PORTAL_ORIGINS=http://localhost:5173

# ── tenant portal (F-C1: must be a real secret in staging/prod — never rely on code defaults) ──
TENANT_SECRET_ENCRYPTION_KEY=      # F-C6: encrypts tenants.hmac_secret at rest. Set on BOTH
                                   # the control plane and tenant portal, then run
                                   # scripts/encrypt_tenant_secrets.py. Losing it after
                                   # --finalize means re-issuing every tenant secret.
TENANT_PORTAL_JWT_SECRET=          # REQUIRED when hosted - startup fails without it.
                                   # Signs portal tokens AND verifies them in
                                   # telephony routes; there is no fallback (F-C1)
TENANT_PORTAL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
                                   # Hosted: comma-separated dashboard origins that may call
                                   # the portal API (CORS). Include every Vercel/production
                                   # URL, e.g. https://urdu-agent-sdk.vercel.app
PORTAL_ALLOW_TENANT_BOOTSTRAP=     # P1-H1: hosted defaults to OFF (invite/claim only).
PORTAL_ALLOW_BROWSER_SECRET_REVEAL= # default ON — owners see HMAC on API Keys. Set 0 to hide.
PORTAL_ALLOW_BROWSER_SECRET_ROTATE= # default OFF — console rotate disabled; admin only.
                                   # Set to 1 only if you intentionally want open signup to
                                   # auto-create a tenant. Local/dev defaults to ON.
UVA_CONTROL_PLANE_URL=http://127.0.0.1:8000
                                   # Required on the tenant portal for dashboard Test Studio
                                   # (HMAC mint proxy). Same URL host backends use.

# ── telephony ──
TELEPHONY_PROVIDER_MODE=real       # real for staging/prod; mock/test/local offline only
TELEPHONY_CREDENTIAL_ENCRYPTION_KEY=
TELNYX_PUBLIC_KEY=
TELEPHONY_WEBHOOK_PUBLIC_BASE_URL=
TELEPHONY_ENABLE_REAL_PROVIDER_TESTS=false
# Outbound voice-profile country whitelist (ISO 3166-1 alpha-2).
# Unset → US,CA only (PK and most international destinations blocked).
# all → full published Telnyx coverage list in telnyx_destinations.py
# US,CA,PK → exact list. Telnyx account must also enable those destinations.
# TELNYX_OUTBOUND_DESTINATIONS=all
# TELEPHONY_ALLOW_MOCK_MACHINE_AUTH=  # local tests only — NEVER on Render staging/prod
