# Backend environment — copy to .env and fill in values
# NEVER commit .env

# URL of the tenant_portal_api Python server (default: local dev)
UVA_API_BASE_URL=http://localhost:8000
UVA_TELEPHONY_API_URL=http://localhost:8000

# Tenant credentials (can also be set at runtime via the UI Setup tab)
UVA_TENANT_ID=
UVA_HMAC_SECRET=

# Telnyx configuration for telephony testing
TELNYX_API_KEY=

# Port for this Express proxy server
PORT=3001
