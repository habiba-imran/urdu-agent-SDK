# Backend environment - copy to backend/.env and fill in values.
# NEVER commit backend/.env.

# Tenant portal API. Used by @awaazlabs-uva/agents and @awaazlabs-uva/telephony.
UVA_API_BASE_URL=http://localhost:8000
UVA_TELEPHONY_API_URL=http://localhost:8000

# Control-plane session mint service. This is usually the separate control-plane Render service.
UVA_SESSION_UPSTREAM_URL=http://localhost:7860

# Browser-safe key. The backend validates browser session requests against this value.
UVA_PUBLISHABLE_KEY=

# Tenant credentials for backend-only SDK signing.
UVA_TENANT_ID=
UVA_HMAC_SECRET=

# Local test app settings.
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Keep this off unless you intentionally want reserve, purchase, or outbound-call tests to run.
ALLOW_PAID_TELEPHONY_ACTIONS=0

# Telnyx API key is entered in the Setup tab at runtime and kept in backend memory only.
