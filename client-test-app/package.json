{
  "name": "uva-client-test-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client integration test app for AwaazLabs UVA SDK — Telnyx number management, agent creation, and provider testing.",
  "scripts": {
    "install:sdks": "npm install ../client-submission_v2/sdk/@awaazlabs-uva/agents/awaazlabs-uva-agents-0.1.0.tgz ../client-submission_v2/sdk/@awaazlabs-uva/telephony/awaazlabs-uva-telephony-0.1.0.tgz",
    "backend": "node backend/server.js",
    "frontend": "npx serve frontend -p 3000 --no-clipboard",
    "dev": "npx concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "@awaazlabs-uva/agents": "file:../client-submission_v2/sdk/@awaazlabs-uva/agents/awaazlabs-uva-agents-0.1.0.tgz",
    "@awaazlabs-uva/telephony": "file:../client-submission_v2/sdk/@awaazlabs-uva/telephony/awaazlabs-uva-telephony-0.1.0.tgz",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "serve": "^14.2.3"
  }
}
