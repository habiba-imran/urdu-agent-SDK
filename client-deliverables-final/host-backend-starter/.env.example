# Tenant identity (from AwaazLabs provisioning — fill now)
UVA_TENANT_ID=
UVA_HMAC_SECRET=
UVA_PUBLISHABLE_KEY=

# Session upstream (fill when control plane is deployed)
# Example: https://control-plane.example.com
UVA_CONTROL_PLANE_URL=

# Your host
PORT=3000
HOST_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Optional public URL used when rewriting refreshUrl (recommended in production)
HOST_PUBLIC_BASE_URL=http://localhost:3000
