# Dashboard → portal API (local portal while developing the console itself).
# Prefer the SAME hostname as the browser tab (localhost↔localhost or
# 127.0.0.1↔127.0.0.1). Mixing localhost and 127.0.0.1 is cross-site, so
# SameSite=Lax cookies alone will not stick — the dashboard also keeps an
# in-memory Bearer fallback for that case.
# Tenant-facing host env blocks on API Keys always use Render staging URLs from
# src/lib/platformUrls.ts (control plane + tenant portal).
NEXT_PUBLIC_TENANT_PORTAL_API_URL=http://127.0.0.1:8002

# Optional: local control plane for console-side tools. Not what tenants copy.
NEXT_PUBLIC_CONTROL_PLANE_URL=http://127.0.0.1:8000

# Supabase Auth (Phase 1 dashboard login) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Legal / trust pack (P4-C1) — published ToS / Privacy / DPA URLs for the console
NEXT_PUBLIC_LEGAL_TERMS_URL=
NEXT_PUBLIC_LEGAL_PRIVACY_URL=
NEXT_PUBLIC_LEGAL_DPA_URL=
