      "events": [{"kind": "repeat_sequence", "cycles": 12, "sequence": [{"kind": "agent_playback", "text": "Consultation کی قیمت پندرہ سو روپے ہے۔"}, {"kind": "overlap_speech", "text": "اچھا۔", "intent_label": "receipt", "position": "mid_agent_clause"}, {"kind": "user_speech", "text": "Monday کے hours دوبارہ بتائیں۔"}]}],
      "reference": {"dialogue_act": "maintain_continuity", "must_preserve": ["PKR 1500", "09:00", "17:00"], "must_not": ["lexical_only_takeover_decision", "state_drift"], "listener_goal": "Evaluate mixed repetition and contextual receipts; recipe is not measured long-call evidence."}
